{
  "manifest_version": 3,
  "name": "Sketchpad browser bridge",
  "version": "0.2.0",
  "description": "Lets sketchpad's agents search, read and act in this browser, in background tabs, without taking focus; consequential actions need the human's OK.",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "tabGroups",
    "scripting",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}